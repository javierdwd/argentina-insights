# ── LLM ──────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Vector index (actas + people name search) ─────────────────────
# Precompute with: python scripts/generate_embeddings.py
# Runtime only loads .npy from disk; it does not batch-embed catalogs.
# text-embedding-3-small is cheap; 3-large ranks eponyms better (regen required).
EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_INDEX_DIR=   # default: agent/.cache/vector_index

# ── Model roles ───────────────────────────────────────────────────
# Swap model IDs here without touching source code.
# fast    → cheap; classify (ui | data)
# default → compose_ui (widget tree + brief)
# strong  → respond / tool routing (what to fetch)
MODEL_FAST=gpt-5-nano
MODEL_DEFAULT=gpt-5-mini
MODEL_STRONG=gpt-5-mini

# reasoning_effort per role. gpt-5 / mini / nano: minimal|low|medium|high.
# gpt-5.4 / gpt-5.2: none|low|medium|high|xhigh  (``minimal`` is a 400;
# the factory remaps it to ``none`` automatically).
# REASONING_FAST=minimal
# REASONING_DEFAULT=low
# REASONING_STRONG=low

# Streamed "Pensando…" in CopilotKit. Default is off — ``auto`` dumps a
# long English chain-of-thought into the thread. concise|auto|detailed|off
# REASONING_SUMMARY=off

# ── LangSmith (optional) ──────────────────────────────────────────
# Leave LANGSMITH_API_KEY blank to disable tracing entirely.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=argentina-insights
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── TMDB (The Movie Database) ─────────────────────────────────────
# https://www.themoviedb.org/settings/api — Bearer token preferred.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# ── Live Football API ─────────────────────────────────────────────
# https://live-football-api.com/
LIVE_FOOTBALL_API_KEY=

# ── Server ────────────────────────────────────────────────────────
# Allowed CORS origin (Next.js dev server)
CORS_ORIGIN=http://localhost:3000
