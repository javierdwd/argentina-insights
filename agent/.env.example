# ── LLM ──────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Model roles ───────────────────────────────────────────────────
# Swap model IDs here without touching source code.
# fast    → cheap; classify + respond (pick endpoint / fill params)
# default → compose_ui (widget tree + brief)
# strong  → reserved for HITL / multi-step flows (cases 10-13)
MODEL_FAST=gpt-5-nano
MODEL_DEFAULT=gpt-5-mini
MODEL_STRONG=gpt-5-mini

# reasoning_effort per role. gpt-5 / mini / nano: minimal|low|medium|high.
# gpt-5.4 / gpt-5.2: none|low|medium|high|xhigh  (``minimal`` is a 400;
# the factory remaps it to ``none`` automatically).
# REASONING_FAST=minimal
# REASONING_DEFAULT=low
# REASONING_STRONG=medium

# ── LangSmith (optional) ──────────────────────────────────────────
# Leave LANGSMITH_API_KEY blank to disable tracing entirely.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=argentina-insights
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Server ────────────────────────────────────────────────────────
# Allowed CORS origin (Next.js dev server)
CORS_ORIGIN=http://localhost:3000
